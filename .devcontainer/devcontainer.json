{
  "name": "MCP Server Template Development",
  "image": "mcr.microsoft.com/devcontainers/python:3.10-bookworm",
  
  // Simplified configuration for better compatibility
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  
  // Configure tool-specific properties
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-python.isort",
        "redhat.vscode-yaml",
        "ms-vscode.vscode-json"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.formatting.provider": "black",
        "python.formatting.blackArgs": ["--line-length=88"],
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      }
    }
  },
  
  // Forward ports for development
  "forwardPorts": [8000, 8081],
  "portsAttributes": {
    "8000": {
      "label": "MCP Server",
      "onAutoForward": "notify"
    },
    "8081": {
      "label": "External API",
      "onAutoForward": "silent"
    }
  },
  
  // Run commands after container creation
  "postCreateCommand": "bash .devcontainer/setup.sh",
  
  // Environment variables for development
  "containerEnv": {
    "PYTHONPATH": "/workspaces/syinfo-mcp/src",
    "MCP_HOST": "0.0.0.0",
    "MCP_PORT": "8000",
    "MCP_LOG_LEVEL": "DEBUG",
    "MCP_DEBUG": "true"
  },
  
  // Use 'postStartCommand' to run commands after the container starts
  "postStartCommand": "echo 'MCP Server Development Container Ready! Run: make help'",
  
  // Mount workspace with proper permissions
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/syinfo-mcp,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/syinfo-mcp"
}